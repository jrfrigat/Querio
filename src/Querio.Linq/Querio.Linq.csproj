<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Turns a query into .NET expression trees and runs it over objects. Depends on nothing but the
    core and the BCL: Entity Framework consumes expression trees directly, so a query built here
    reaches a database without this package knowing anything about one.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(QuerioLibTargetFrameworks)</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <PackageId>Querio.Linq</PackageId>
    <RootNamespace>Querio.Linq</RootNamespace>
    <Description>Executes a Querio query as .NET code. Builds expression trees rather than query text, so a saved query can filter an IQueryable through any LINQ provider or run directly over in-memory objects.</Description>
    <PackageTags>query;linq;expression;iqueryable;dotnet</PackageTags>
    <!-- Expression trees are built from types discovered at run time, so trimming cannot see them. -->
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Querio\Querio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Querio\Internal\IsExternalInit.cs" Link="Internal\IsExternalInit.cs" />
  </ItemGroup>

</Project>
