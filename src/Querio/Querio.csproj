<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The core: the schema, the query, the fluent builder, the validator, and the shared walk every
    target renders through. It references nothing - not a UI library, not the web stack, not a
    single NuGet package - so it can be added to a console app, a worker or somebody's existing
    service without an argument about dependencies. QuerioIndependenceTests enforces that with a
    failing build rather than with good intentions.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(QuerioLibTargetFrameworks)</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <PackageId>Querio</PackageId>
    <RootNamespace>Querio</RootNamespace>
    <Description>A database- and ORM-agnostic relational query model: an entity/field/foreign-key schema, a serializable query AST (joins, aggregates, grouping, having, sorting, paging) and a fluent builder. Values travel as data and no SQL text is ever emitted, so every backend renders the same query in its own dialect.</Description>
    <PackageTags>query;query-builder;sql;ast;relational;dotnet</PackageTags>
    <IsTrimmable Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <!-- Read by the trimmer, not by the app: see the file for why the whole assembly is kept. -->
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
