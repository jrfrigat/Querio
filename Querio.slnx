<Solution>
  <!-- The core, and one project per target it can be rendered to. Every target depends on the core
       and on nothing else, so the graph is a star rather than a chain. -->
  <Folder Name="/src/">
    <Project Path="src/Querio/Querio.csproj" />
    <Project Path="src/Querio.Sql/Querio.Sql.csproj" />
    <Project Path="src/Querio.OneC/Querio.OneC.csproj" />
    <Project Path="src/Querio.Text/Querio.Text.csproj" />
    <Project Path="src/Querio.Linq/Querio.Linq.csproj" />
    <Project Path="src/Querio.Http/Querio.Http.csproj" />
    <Project Path="src/Querio.Language/Querio.Language.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Querio.Tests/Querio.Tests.csproj" />
    <Project Path="tests/Querio.Renderers.Tests/Querio.Renderers.Tests.csproj" />
    <Project Path="tests/Querio.Sql.IntegrationTests/Querio.Sql.IntegrationTests.csproj" />
    <Project Path="tests/Querio.Benchmarks/Querio.Benchmarks.csproj" />
    <Project Path="tests/Querio.TrimmingProbe/Querio.TrimmingProbe.csproj" />
  </Folder>
</Solution>
