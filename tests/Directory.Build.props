<Project>
  <!-- Inherit everything the repo sets, then relax what only makes sense for shipped code. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      An xUnit.net v3 test project is its own runner: it builds to an executable that hosts
      Microsoft.Testing.Platform. Microsoft.NET.Test.Sdk used to set this implicitly; the VSTest
      stack is gone, so the projects say it themselves.
    -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      Public API documentation is enforced as an error for the packages, because their XML docs are
      the manual most callers read. A test method's name is its documentation, and demanding a
      /// <summary> on each of several hundred of them would bury the ones that say something worth
      saying.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors.Replace('CS1591',''))</WarningsAsErrors>
  </PropertyGroup>
</Project>
