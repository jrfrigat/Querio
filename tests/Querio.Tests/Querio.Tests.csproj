<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Querio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every shipped package, because QuerioIndependenceTests checks all of them. The dependency
         guard is only worth having if a new package cannot quietly escape it. -->
    <ProjectReference Include="..\..\src\Querio\Querio.csproj" />
    <ProjectReference Include="..\..\src\Querio.Sql\Querio.Sql.csproj" />
    <ProjectReference Include="..\..\src\Querio.OneC\Querio.OneC.csproj" />
    <ProjectReference Include="..\..\src\Querio.Text\Querio.Text.csproj" />
    <ProjectReference Include="..\..\src\Querio.Linq\Querio.Linq.csproj" />
    <ProjectReference Include="..\..\src\Querio.Http\Querio.Http.csproj" />
    <ProjectReference Include="..\..\src\Querio.Language\Querio.Language.csproj" />
  </ItemGroup>

</Project>
