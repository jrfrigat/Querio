<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- BenchmarkDotNet builds and runs the benchmarks from an optimized copy of this assembly, and
         refuses to measure a Debug one. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same schema and the same target list the tests use, linked rather than copied: a
         benchmark measuring a different set of targets from the one under test would drift, and the
         answer to "did that get slower" has to be about the code that shipped. -->
    <Compile Include="..\Querio.Tests\TestSchema.cs" Link="TestSchema.cs" />
    <Compile Include="..\Querio.Renderers.Tests\RenderTargets.cs" Link="RenderTargets.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every target, because "how fast is Querio" has a different answer per renderer and the
         interesting one is usually the slowest. -->
    <ProjectReference Include="..\..\src\Querio\Querio.csproj" />
    <ProjectReference Include="..\..\src\Querio.Sql\Querio.Sql.csproj" />
    <ProjectReference Include="..\..\src\Querio.OneC\Querio.OneC.csproj" />
    <ProjectReference Include="..\..\src\Querio.Text\Querio.Text.csproj" />
    <ProjectReference Include="..\..\src\Querio.Linq\Querio.Linq.csproj" />
    <ProjectReference Include="..\..\src\Querio.Http\Querio.Http.csproj" />
    <ProjectReference Include="..\..\src\Querio.Language\Querio.Language.csproj" />
  </ItemGroup>

</Project>
